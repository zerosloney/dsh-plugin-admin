{
  "name": "dsh-plugin-admin",
  "version": "1.26.1",
  "type": "module",
  "description": "dsh Web UI admin plugin: eleven management panels (extensions, skills, MCP servers, subagents, commands, hooks, automation - cron / webhook / workflow, sessions & web search, usage dashboard, todo dock) inside the official dsh settings UI",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerosloney/dsh-plugin-admin.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "admin",
    "subagent",
    "mcp",
    "session",
    "commands",
    "hooks",
    "cordis"
  ],
  "scripts": {
    "test": "node scripts/run-gate.mjs",
    "check:types": "tsc --noEmit",
    "check:types-strict": "tsc -p tsconfig.strict.json --noEmit",
    "check:lint": "oxlint lib src scripts",
    "build:client": "node scripts/build-client.mjs",
    "test:matrix": "node scripts/check-matrix.mjs",
    "smoke:real-host": "node scripts/smoke-real-host.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "esbuild": ">=0.17.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.85.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
