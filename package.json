{
  "name": "dsh-plugin-admin",
  "version": "0.4.2",
  "type": "module",
  "description": "dsh web UI plugin: administration surfaces for the settings UI — 扩展插件 tab in the Plugins page, plus MCP服务器 and 历史会话 settings pages (host remote + browser panel)",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerosloney/dsh-plugin-admin.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "admin",
    "cordis"
  ],
  "scripts": {
    "test": "node scripts/self-check.mjs && node scripts/host-check.mjs && node scripts/verify-mcp-cache.mjs && node scripts/verify-update-reminders.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
