{
  // The strict track (Wave 5 of the improvement plan): a second tsconfig that
  // turns on the flags the main config does not, over a GROWING list of files.
  // Each new file joins by fixing its implicit-any leaks first, and the include
  // list only ever grows. When it covers everything, fold the flags back into
  // tsconfig.json and delete this file.
  //
  // The list is by ENTRY FILE, but `tsc` follows imports: a file can only join
  // once its whole transitive import closure is clean, which is why the entries
  // here are standalone leaves and small self-contained modules. The remaining
  // host files are not excluded by policy — they carry the ~1900 implicit-any
  // findings that need real type models (untyped local object literals, untyped
  // callback parameters) rather than annotations that would just say `any` and
  // defeat the flag. Each joins as it is modelled.
  //
  // Run: npm run check:types-strict   (a permanent run-gate step)
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": true
  },
  "include": [
    "types/**/*.d.ts",
    "lib/patch-utils.js",
    "lib/usage-ledger.js",
    "lib/health-report.js",
    "lib/panel-ids.js",
    "lib/rpc-schema.js",
    "lib/secret-fields.js",
    "lib/workflow-realm-shared.js",
    "lib/workflow-realm-worker.js",
    "lib/rpc-manifest.js",
    "lib/audit-log.js",
    "lib/session-export.js",
    "lib/peer-compat.js",
    "lib/run-command.js",
    "lib/shell-policy.js",
    "lib/store-version.js",
    "lib/tool-seed.js",
    "lib/overlay-admin.js",
    "lib/skills-admin.js",
    "lib/workflow-command.js",
    "lib/workspace-admin.js",
    "lib/workflow-engine.js",
    "lib/command-hook-admin.js",
    "lib/project-agents.js",
    "lib/workflow-runs.js",
    "lib/project-hooks.js",
    "lib/workspace-path.js",
    "lib/fs-admin.js",
    "lib/workflow-tools.js",
    "lib/workflow-library.js",
    "lib/workflow-admin.js",
    "lib/webhook-triggers.js",
    "lib/cron-admin.js"
  ]
}
