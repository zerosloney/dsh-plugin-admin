{
  // Phase A2: static checking without a TypeScript rewrite. The host half is
  // plain ESM JavaScript with dense JSDoc, so checkJs buys most of a type
  // system's drift protection for zero runtime change.
  //
  // Scope: the host half (lib/**.js) and the browser SOURCES (src/client/**).
  // lib/client.js is excluded because it is a build product of src/client now
  // (Phase B1) — `npm run build:client --check` guards that it matches.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    // strictNullChecks + noImplicitAny are permanent defaults: both strict
    // tracks reached full coverage and were folded back (see CHANGELOG).
    // They stay independent keys rather than `strict: true` because the
    // remaining strict flags are still being adopted file by file.
    "strictNullChecks": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // Node globals (Buffer / setTimeout / AbortController) come from
    // @types/node; the host seams the plugin duck-types are declared in
    // types/dsh-seams.d.ts instead of an @deepseek-ai/dsh-* import.
    "types": ["node"]
  },
  "include": ["lib/**/*.js", "src/client/**/*.js", "types/**/*.d.ts"],
  "exclude": ["node_modules", "lib/client.js", "lib/client.panels.js"]
}
