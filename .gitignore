# Node.js
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tgz

# dsh / profile runtime artifacts
.host-check-tmp*/
out.txt
.probe/
*.tmp

# local dsh checkouts for the seam probe / version matrix (same paths CI checks
# out — see .github/workflows/ci.yml)
.dsh-checkout/
.dsh-release/
.dsh-main/

# cbx local tool state
.cbx/

# zcode local tool state
.zcode/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# transient tsc diagnostic dumps (npm run check:types writes only stdout)
.tsc-report.txt

# scratch working files: the strict-track measurement scripts, per-file probe
# configs and diff dumps all write tmp-* here — and an untracked file is one
# `git add -A` away from being committed (that has actually happened three
# times in a single session).
tmp-*

# pnpm byproducts. This package is published through npm and commits no pnpm
# lockfile on purpose, but ANY pnpm run from this directory (a `pnpm add` in a
# profile anchored at the repo, a stray CLI call) leaves these three files
# behind as untracked noise — and an untracked file is one `git add -A` away
# from being committed.
/pnpm-lock.yaml
pnpm-lock.yaml
/pnpm-workspace.yaml
pnpm-workspace.yaml
/.pnpm-store/
.pnpm-store/
